{
  "$schema": "https://tree-sitter.github.io/tree-sitter/assets/schemas/config.schema.json",
  "grammars": [
    {
      "name": "mib",
      "camelcase": "Mib",
      "title": "SNMP MIB",
      "scope": "source.mib",
      "file-types": ["mib", "my", "smi", "smiv1", "smiv2"],
      "injection-regex": "^(mib|smi|snmp)$",
      "class-name": "TreeSitterMib",
      "highlights": "queries/highlights.scm",
      "tags": "queries/tags.scm"
    }
  ],
  "metadata": {
    "version": "0.1.0",
    "license": "MIT",
    "description": "SNMP MIB (SMIv1/SMIv2) grammar for tree-sitter",
    "authors": [{ "name": "Eric Brown" }],
    "links": { "repository": "https://github.com/ericwb/tree-sitter-mib" }
  },
  "bindings": { "c": true, "go": false, "node": true, "python": true, "rust": true, "swift": false, "zig": false }
}
